{
  "expo": {
    "name": "Tell Liora",
    "slug": "liora-local",
    "scheme": "tellliora",
    "version": "0.1.0",
    "icon": "./assets/images/icon.png",
    "platforms": [
      "web",
      "ios"
    ],
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "bundleIdentifier": "com.lumosynlabs.tellliora",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "enableOpenCLAndHexagon": false
        }
      ],
      "./plugins/with-scene-lifecycle",
      [
        "expo-audio",
        {
          "microphonePermission": "Liora uses the microphone only when you tap the mic, to write down what you say. Your voice stays on this phone."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Liora uses Face ID only to open your private log, mood check and calendar. It never locks the help screens."
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/liora-local"
    }
  }
}
